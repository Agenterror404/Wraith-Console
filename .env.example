# Copy to .env (git-ignored) and fill in.

# Wraith Console auth — BOTH required, no defaults; the console refuses to start without them.
# Generate the secret with:  openssl rand -base64 48
WRAITH_UI_PASSWORD=
WRAITH_UI_SECRET=

# Optional: login username (default "Agent")
# WRAITH_UI_USERNAME=Agent

# Optional: if you serve the console over plain HTTP (no TLS), set this so the browser
# keeps the session cookie. Only do this on a trusted/private network (VPN, loopback,
# SSH tunnel) — never on the public internet.
# WRAITH_UI_INSECURE_COOKIE=1

# Optional: scope + evidence locations (defaults: ./scope.yaml, ./evidence)
# PENTEST_SCOPE_FILE=/app/scope.yaml
# PENTEST_EVIDENCE_DIR=/app/evidence

# Optional: browser fingerprint geo (timezone/locale/geolocation) to match your egress.
# PENTEST_EXIT=chicago
# PENTEST_EXIT_TZ=America/Chicago
# PENTEST_EXIT_LOCALE=en-US
# PENTEST_EXIT_LAT=41.8781
# PENTEST_EXIT_LON=-87.6298
